# Archivo .env para configurar la app Django dentro de Docker.


# ------------------------------------------------------------
# Configuración de Keycloak: URLs, realm y clientes usados por Django.
# Cambiar estas URLs si Keycloak corre en otra máquina o puerto.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8080

# Nombre del realm que se importa desde keycloak/realm-config.
KEYCLOAK_REALM=ds-2025-realm

# Credenciales del cliente web que usa el login de usuarios finales.
KEYCLOAK_CLIENT_ID=grupo-04
KEYCLOAK_CLIENT_SECRET=6be1bec1-9472-499f-ab37-883d78f57829

# Audiencias válidas que el backend espera en los tokens.
KEYCLOAK_EXPECTED_AUDIENCE=account,grupo-04

# Cliente de servicio (backend-to-backend) para consumir APIs protegidas.
KEYCLOAK_SERVICE_CLIENT_ID=grupo-04
KEYCLOAK_SERVICE_CLIENT_SECRET=6be1bec1-9472-499f-ab37-883d78f57829
KEYCLOAK_SERVICE_SCOPE=productos:read

# ------------------------------------------------------------
# URLs base que Django usa para construir endpoints y consumir APIs externas.
# SITE_URL: dominio público del frontend (Nginx lo redirige a Django).
SITE_URL=http://localhost

# Prefijo bajo el cual se sirve la app completa .
APP_PATH_PREFIX=/compras

# Habilitar/deshabilitar el uso de datos mock para las APIs internas.
USE_MOCK_APIS=false 

# URL base que usan los módulos internos para llamar a sus propias APIs REST.
BASE_API_URL=http://localhost/compras/api/
PRODUCTOS_API_BASE_URL=http://localhost/compras


# Endpoints de los microservicios integrados (producto, stock, logística).
STOCK_API_BASE_URL=http://localhost/stock/
LOGISTICA_API_BASE_URL=http://localhost/logistica/
